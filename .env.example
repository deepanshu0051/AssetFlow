# AssetFlow - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=your_mongodb_atlas_uri_here

# Security
# Generate a strong random string for your JWT secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Admin Registration Key (required for Admin sign-up)
ADMIN_ACCESS_ID=your_admin_access_id_here

# Super Admin Registration Key (required for Super Admin sign-up)
SUPER_ADMIN_KEY=your_super_admin_key_here

# CORS Configuration (Required for Production)
# List allowed frontend URLs separated by commas
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app

# Email Service (Nodemailer - Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
FROM_NAME=AssetFlow
FROM_EMAIL=noreply@assetflow.com
