# AssetFlow - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=your_mongodb_atlas_uri_here

# Security
# Generate a strong random string for your JWT secret
JWT_SECRET=your_jwt_secret_key_here

# Optional: Frontend URL for CORS (Production only)
# ALLOWED_ORIGINS=https://yourfrontend.com,https://anotherdomain.com
